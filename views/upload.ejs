<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Enviar fotos — <%= coupleNames %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="container">
    <div class="hero">
      <p class="names"><%= coupleNames %></p>
      <p class="date">Compartilhe suas fotos da nossa festa</p>
    </div>

    <svg class="wave-divider" viewBox="0 0 300 30" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 15 Q 37.5 0 75 15 T 150 15 T 225 15 T 300 15 V30 H0 Z" fill="#DCEEF2"></path>
    </svg>

    <div id="feedback" class="feedback"></div>

    <form id="upload-form" class="card" autocomplete="off">
      <div class="pick-grid">
        <button type="button" class="pick-card" id="btn-camera">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 8h3l1.5-2h7L17 8h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"/><circle cx="12" cy="14" r="3.5"/></svg>
          Tirar foto
        </button>
        <button type="button" class="pick-card" id="btn-library">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="M21 16l-5.5-5.5L4 21"/></svg>
          Escolher da galeria
        </button>
      </div>

      <input type="file" id="input-camera" accept="image/*" capture="environment" hidden />
      <input type="file" id="input-library" accept="image/*" multiple hidden />

      <div id="preview-grid" class="preview-grid"></div>

      <div class="field">
        <label for="guestName">Seu nome (opcional)</label>
        <input type="text" id="guestName" name="guestName" maxlength="<%= guestTextMaxLength %>" placeholder="Quem está enviando?" />
      </div>
      <div class="field">
        <label for="message">Recado para os noivos (opcional)</label>
        <textarea id="message" name="message" rows="2" maxlength="<%= guestTextMaxLength %>" placeholder="Deixe uma mensagem carinhosa..."></textarea>
      </div>

      <button type="submit" class="btn btn-primary" id="submit-btn" disabled>Enviar fotos</button>
      <p class="hint">Até <%= maxFiles %> fotos por envio · até <%= maxFileSizeMb %>MB cada</p>
    </form>

    <p class="nav-links"><a href="/galeria">Ver galeria ao vivo →</a></p>
  </div>

  <script>
    window.ALBUM_CONFIG = { maxFiles: <%= maxFiles %> };
  </script>
  <script src="/js/upload.js"></script>
</body>
</html>
