<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <title>Enviar fotos — <%= coupleNames %></title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@400;500;600&display=swap"
            rel="stylesheet"
        />
        <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>" />
    </head>
    <body>
        <div class="container">
            <div class="hero">
                <p class="names"><%= coupleNames %></p>
                <p class="date">Compartilhe suas fotos da nossa festa</p>
            </div>

            <svg class="wave-divider" viewBox="0 0 300 30" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0 15 Q 37.5 0 75 15 T 150 15 T 225 15 T 300 15 V30 H0 Z" fill="#DCEEF2"></path>
            </svg>

            <div id="feedback" class="feedback"></div>

            <form id="upload-form" class="card" autocomplete="off">
                <img
                    src="/images/form-header.jpg"
                    alt=""
                    style="
                        display: block;
                        width: calc(100% + 40px);
                        margin: -20px -20px 18px;
                        max-width: none;
                        aspect-ratio: 21 / 9;
                        object-fit: cover;
                        object-position: center 75%;
                        border-radius: var(--radius-lg) var(--radius-lg) 0 0;
                    "
                />
                <div class="pick-grid">
                    <button type="button" class="pick-card" id="btn-camera-photo">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                            <path d="M4 8h3l1.5-2h7L17 8h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z" />
                            <circle cx="12" cy="14" r="3.5" />
                        </svg>
                        Tirar foto
                    </button>
                    <button type="button" class="pick-card" id="btn-camera-video">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                            <path d="M15 10.5V7a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-3.5l4 3.5V7l-4 3.5z" />
                        </svg>
                        Gravar vídeo
                    </button>
                    <button type="button" class="pick-card" id="btn-library">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                            <rect x="3" y="4" width="18" height="16" rx="2" />
                            <circle cx="8.5" cy="9.5" r="1.5" />
                            <path d="M21 16l-5.5-5.5L4 21" />
                        </svg>
                        Escolher da galeria
                    </button>
                </div>

                <input type="file" id="input-camera-photo" accept="image/*" capture="environment" hidden />
                <input type="file" id="input-camera-video" accept="video/*" capture="environment" hidden />
                <input type="file" id="input-library" accept="image/*,video/*" multiple hidden />

                <div id="preview-grid" class="preview-grid"></div>

                <div class="field">
                    <label for="guestName">Seu nome (opcional)</label>
                    <input type="text" id="guestName" name="guestName" maxlength="<%= guestTextMaxLength %>" placeholder="Quem está enviando?" />
                </div>
                <div class="field">
                    <label for="message">Recado para os noivos (opcional)</label>
                    <textarea
                        id="message"
                        name="message"
                        rows="2"
                        maxlength="<%= guestTextMaxLength %>"
                        placeholder="Deixe uma mensagem carinhosa..."
                    ></textarea>
                </div>

                <button type="submit" class="btn btn-primary" id="submit-btn" disabled>Enviar</button>
                <p class="hint">
                    Até <%= maxFiles %> fotos/vídeos por envio · fotos até <%= maxFileSizeMb %>MB ·
                    vídeos até <%= maxVideoFileSizeMb %>MB e <%= maxVideoDurationSeconds %>s
                </p>
            </form>

            <p class="nav-links"><a href="/galeria">Ver galeria ao vivo →</a></p>
        </div>

        <script>
            window.ALBUM_CONFIG = { maxFiles: <%= maxFiles %> };
        </script>
        <script src="/js/upload.js?v=<%= assetVersion %>"></script>
    </body>
</html>
