<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Galeria — <%= coupleNames %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>" />
</head>
<body>
  <div class="gallery-header">
    <p class="names"><%= coupleNames %></p>
    <p class="date">Fotos enviadas pelos convidados, ao vivo</p>
  </div>

  <div id="gallery-grid" class="gallery-grid">
    <% if (photos.length === 0) { %>
      <p class="gallery-empty" id="empty-state">Nenhuma foto ainda — seja o(a) primeiro(a) a enviar!</p>
    <% } %>
    <% photos.forEach((photo) => {
      const isVideo = (photo.mimeType || '').startsWith('video/');
    %>
      <div
        class="gallery-card"
        data-seq="<%= photo.seq %>"
        data-id="<%= photo.id %>"
        data-type="<%= isVideo ? 'video' : 'photo' %>"
        <% if (isVideo) { %>data-src="/uploads/<%= photo.localFilename %>"<% } %>
      >
        <img src="/thumbnails/<%= photo.thumbnailFilename %>" loading="lazy" alt="<%= isVideo ? 'Vídeo' : 'Foto' %> enviado(a) por convidado" />
        <% if (isVideo) { %><span class="play-badge" aria-hidden="true">▶</span><% } %>
        <% if (photo.guestName || photo.message) { %>
          <div class="gallery-caption">
            <% if (photo.guestName) { %><p class="guest-name"><%= photo.guestName %></p><% } %>
            <% if (photo.message) { %><p class="message"><%= photo.message %></p><% } %>
          </div>
        <% } %>
        <button type="button" class="remove-btn" data-remove-id="<%= photo.id %>">Remover</button>
      </div>
    <% }); %>
  </div>

  <dialog id="lightbox">
    <img id="lightbox-img" src="" alt="" />
    <video id="lightbox-video" controls playsinline style="display: none"></video>
  </dialog>

  <p class="nav-links"><a href="/upload">← Enviar mais fotos</a></p>

  <script>
    window.ALBUM_CONFIG = {
      lastSeq: <%= photos.length ? photos[0].seq : 0 %>
    };
  </script>
  <script src="/js/gallery.js?v=<%= assetVersion %>"></script>
</body>
</html>
