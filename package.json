{
  "name": "album-de-casamento",
  "version": "1.0.0",
  "private": true,
  "description": "Site de casamento: upload de fotos via QR code, fila em Redis com lote a cada 2s, armazenamento em bucket S3-compativel (Hetzner) e galeria publica ao vivo.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "dev": "node --watch src/server.js",
    "dev:worker": "node --watch src/worker.js",
    "migrate": "node src/db/migrate.js",
    "check-failures": "node scripts/check-failures.js",
    "requeue-failed": "node scripts/requeue-failed.js",
    "backup-db": "node scripts/backup-db.js",
    "generate-qrcode": "node scripts/generate-qrcode.js"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.699.0",
    "better-sqlite3": "^11.7.0",
    "compression": "^1.7.5",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "file-type": "^22.0.1",
    "heic-convert": "^2.1.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "multer": "^1.4.5-lts.1",
    "p-limit": "^6.1.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.0",
    "sharp": "^0.35.3",
    "uuid": "^11.0.3"
  }
}
