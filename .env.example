# Servidor
PORT=3000
NODE_ENV=production
COUPLE_NAMES="Nome1 & Nome2"
WEDDING_DATE="2026-12-31"
SITE_URL="https://seu-dominio.com.br"

# Redis (sinal de fila + store de rate limit)
REDIS_URL="redis://127.0.0.1:6379"

# Bucket S3-compativel (Hetzner Object Storage)
S3_ENDPOINT="https://fsn1.your-objectstorage.com"
S3_REGION="fsn1"
S3_BUCKET="album-casamento"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PREFIX="uploads/"

# Upload
MAX_FILE_SIZE_MB=50
MAX_VIDEO_FILE_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=90
MAX_FILES_PER_REQUEST=15
MAX_REQUEST_SIZE_MB=550
GUEST_TEXT_MAX_LENGTH=140

# Fila / worker
QUEUE_TICK_MS=2000
QUEUE_BATCH_SIZE=20
QUEUE_UPLOAD_CONCURRENCY=5
QUEUE_LEASE_SECONDS=60
QUEUE_MAX_ATTEMPTS=6

# Rate limit (por IP, endpoint de upload)
UPLOAD_RATE_LIMIT_WINDOW_MINUTES=15
UPLOAD_RATE_LIMIT_MAX=30

# Galeria
GALLERY_PAGE_SIZE=24
# Token secreto opcional para revelar botao de ocultar foto na galeria (/galeria?mod=TOKEN)
GALLERY_MOD_TOKEN=""
